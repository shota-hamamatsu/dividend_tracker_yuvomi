{
  "manifestVersion": 1,
  "id": "dividend-tracker",
  "name": "Dividend Tracker",
  "version": "0.6.0",
  "description": "Record family dividends with holder and share count, and see yearly and monthly totals from the dividend per share on each pay date. Requires the sidecar service.",
  "entry": "index.js",
  "style": "style.css",
  "icon": "wallet",
  "accent": "#16A34A",
  "i18n": {
    "defaultLocale": "en"
  },
  "menu": {
    "show": true,
    "label": "Dividends",
    "icon": "wallet",
    "order": 100,
    "labelKey": "menu"
  },
  "page": {
    "composition": "data",
    "width": "content",
    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "Dividend Tracker",
        "icon": "wallet",
        "labelKey": "module"
      }
    },
    "api": {
      "prefix": "/api/extensions/dividend-tracker"
    }
  }
}
