{
    "name": "dividend-tracker-yuvomi",
    "version": "0.6.0",
    "private": true,
    "type": "module",
    "description": "Dividend tracker module for yuvomi.cloud (TypeScript built to modules/dividend-tracker/index.js) and its sidecar (server/)",
    "scripts": {
        "dev": "vite --config vite.dev.config.ts",
        "build": "vite build",
        "build:pages": "vite build --config vite.pages.config.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "node --test --experimental-strip-types src/**/*.test.ts server/**/*.test.ts",
        "start:server": "node --experimental-strip-types server/main.ts"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "22.20.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "8.3.8"
    }
}
