{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"],
        "paths": { "/api.js": ["./src/types/api.d.ts"] }
    },
    "include": ["src", "server", "dev", "vite.config.ts", "vite.dev.config.ts"]
}
