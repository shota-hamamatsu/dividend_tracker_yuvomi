{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"],
        "paths": {
            "/api.js": ["./src/types/api.d.ts"],
            "/i18n.js": ["./src/types/i18n.d.ts"]
        }
    },
    "include": [
        "src",
        "server",
        "dev",
        "vite.config.ts",
        "vite.dev.config.ts",
        "vite.pages.config.ts"
    ]
}
